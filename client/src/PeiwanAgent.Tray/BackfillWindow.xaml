<Window x:Class="PeiwanAgent.Tray.BackfillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="本地私人片段 - 漏录授权补传"
        Width="580"
        Height="420"
        WindowStartupLocation="CenterOwner"
        Background="#161B22"
        Foreground="#F0F6FC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="仅展示最近 3 天未标记接单的本地片段；私人局默认绝不自动上传，仅经您显式授权后才加入补传队列。"
                   TextWrapping="Wrap" Foreground="#8B949E" FontSize="12"/>

        <ListBox x:Name="SegmentList" Grid.Row="1" Margin="0,10,0,10" SelectionMode="Multiple"
                 Background="#0D1117" Foreground="#F0F6FC" BorderBrush="#30363D"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,8">
            <TextBox x:Name="OrderRefInput" Width="180" Padding="6,4" Background="#0D1117" Foreground="#F0F6FC" BorderBrush="#30363D" ToolTip="订单号（可选）"/>
            <TextBox x:Name="NoteInput" Width="340" Margin="10,0,0,0" Padding="6,4" Background="#0D1117" Foreground="#F0F6FC" BorderBrush="#30363D" ToolTip="备注说明（可选）"/>
        </StackPanel>

        <CheckBox x:Name="ConsentCheck" Grid.Row="3" Margin="0,4,0,10" Foreground="#F0F6FC"
                  Content="我确认上述选中片段为漏点接单的对局，授权系统在空闲时上传至所在工作室云端用于售后核对"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="关闭" Width="80" Height="30" Background="#30363D" Foreground="White" BorderThickness="0" Click="Close_Click"/>
            <Button Content="授权加入补传队列" Width="150" Height="30" Margin="10,0,0,0"
                    Background="#1F6FEB" Foreground="White" BorderThickness="0" Click="Submit_Click"/>
        </StackPanel>
    </Grid>
</Window>
