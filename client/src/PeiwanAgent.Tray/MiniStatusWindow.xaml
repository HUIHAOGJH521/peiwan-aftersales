<Window x:Class="PeiwanAgent.Tray.MiniStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="陪玩售后助手"
        Width="340"
        Height="230"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="#161B22"
        Foreground="#F0F6FC">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#8B949E" Margin="0,0,8,0"/>
            <TextBlock x:Name="StatusTitle" Text="待机（等待游戏启动）" FontSize="14" FontWeight="SemiBold"/>
        </StackPanel>

        <TextBox x:Name="OrderRefBox" Grid.Row="1" Margin="0,10,0,0" Padding="6,4"
                 Background="#0D1117" Foreground="#F0F6FC" BorderBrush="#30363D"
                 ToolTip="可选：填写订单号"/>
        <TextBlock Grid.Row="1" Margin="8,15,0,0" IsHitTestVisible="False" Foreground="#6E7681" FontSize="12"
                   Text="可选填写：订单号（如 BX2026...）"
                   x:Name="OrderRefHint"/>

        <TextBox x:Name="NoteBox" Grid.Row="2" Margin="0,8,0,0" Padding="6,4"
                 Background="#0D1117" Foreground="#F0F6FC" BorderBrush="#30363D"
                 ToolTip="可选：填写接单备注"/>
        <TextBlock Grid.Row="2" Margin="8,13,0,0" IsHitTestVisible="False" Foreground="#6E7681" FontSize="12"
                   Text="可选填写：备注（如 护航两把航天）"
                   x:Name="NoteHint"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="ToggleOrderBtn" Content="开始接单" Width="105" Height="30"
                    Background="#238636" Foreground="White" BorderThickness="0" Click="ToggleOrderBtn_Click"/>
            <Button x:Name="PauseBtn" Content="暂停" Width="70" Height="30" Margin="8,0,0,0"
                    Background="#30363D" Foreground="White" BorderThickness="0" Click="PauseBtn_Click"/>
            <Button Content="漏录补传" Width="85" Height="30" Margin="8,0,0,0"
                    Background="#1F6FEB" Foreground="White" BorderThickness="0" Click="BackfillBtn_Click"/>
        </StackPanel>

        <TextBlock x:Name="HintText" Grid.Row="4" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="#8B949E" FontSize="11.5"
                   Text="提示：私人局仅本地保留3天，绝不自动上云；游戏运行中不占上行带宽。"/>
    </Grid>
</Window>
